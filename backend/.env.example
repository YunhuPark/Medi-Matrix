# 주의: 실제 키 값은 예제 파일에 절대 작성하지 마십시오.
APP_ENV=development

# APP_ENV=production에서는 ALLOWED_ORIGINS 설정이 필수입니다.
ALLOWED_ORIGINS=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=medical-meshes

# 신뢰할 수 있는 프록시가 X-Forwarded-For 헤더를 안전하게 정리해 주는 환경에서만 true로 사용하십시오.
TRUST_PROXY_HEADERS=false

TRIAGE_API_URL=
MAX_UPLOAD_SIZE=52428800
MAX_VITALS_UPLOAD_SIZE=5242880
MAX_VITALS_ROWS=1000
SIGNED_URL_EXPIRES_IN=600

# Vision inference: 아직 검증된 영상 모델이 없어 demo만 사용합니다.
INFERENCE_MODE=demo

# Vitals inference는 Vision과 독립적으로 설정합니다.
# demo: 결정론적 fallback / model: reviewed PhysioNet GRU artifact
VITALS_INFERENCE_MODE=demo
# 기본값은 backend/models/vitals_gru_challenge2019_v1/model.pt 입니다.
VITALS_MODEL_PATH=
VITALS_MODEL_MAX_HISTORY=256

SUPABASE_VITALS_BUCKET=medical-vitals
